wBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M7.5 12.5l3 3 6-6.5\"/></svg>'\nPART = '<svg class=\"mk p\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 2a10 10 0 010 20z\" class=\"f\"/></svg>'\nNO = '<svg class=\"mk n\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M8.5 8.5l7 7M15.5 8.5l-7 7\"/></svg>'\nM = {'y': YES, 'p': PART, 'n': NO}\n\n# (icon, feature, stand-out, cells[ (mark, text) ] for FirstRun, Claude Code, Actions, Agents, Custom)\nROWS = [\n ('run', 'Runs the quickstart as a new developer', 0, [\n  ('y', 'Every step runs in a fresh Docker container'),\n  ('p', 'Runs on your machine. An optional OS sandbox limits files and network'),\n  ('p', 'A fresh runner per job, but you script every step'),\n  ('p', 'Works in its own Actions-powered VM, on your repo, not a new-user setup'),\n  ('p', 'Only as clean as the environment you build')]),\n ('plan', 'Plans steps from a docs URL', 0, [\n  ('y', 'The planner writes one step per command'),\n  ('y', 'When you prompt it with the page'),\n  ('n', 'You write each step'),\n  ('n', 'Starts from an issue or task, not a docs page'),\n  ('n', 'You write the parser')]),\n ('fix', 'Improvises when a step fails', 1, [\n  ('y', 'Classifies the failure, patches, retries up to 3 times per step'),\n  ('y', 'Iterates inside one session'),\n  ('n', 'The job fails and stops'),\n  ('y', 'Iterates in one session and pushes commits to its draft PR'),\n  ('p', 'Only what you code')]),\n ('prove', 'Proves the fix', 0, [\n  ('y', 'A second clean container must pass the whole quickstart'),\n  ('p', 'Only if you ask for it'),\n  ('p', 'Only if you script a second run'),\n  ('p', 'Your repo\\'s own tests and CI, not a clean-user rerun'),\n  ('p', 'Only if you code it')]),\n ('tele', 'Telemetry per run', 1, [\n  ('y', 'neatlogs spans for planner, executor and verifier. Measured cost of $0.02 per run'),\n  ('p', 'OpenTelemetry metrics and events, such as cost and tokens. Set up through environment variables'),\n  ('p', 'Logs and run history. No agent traces'),\n  ('p', 'A session log you can read or stream. No cost trace you own'),\n  ('n', 'You build it')]),\n ('pr', 'Opens the docs PR', 0, [\n  ('y', 'After you approve once'),\n  ('y', 'When you ask'),\n  ('p', 'Only if you script it'),\n  ('y', 'Opens a draft PR and asks you for review'),\n  ('p', 'Only if you code it')]),\n ('ease', 'Ease of use', 1, [\n  ('y', 'Paste a docs URL, then paste the prompt into your coding agent'),\n  ('p', 'One prompt, but you define the test and the clean setup'),\n  ('p', 'A YAML file per quickstart'),\n  ('y', 'Assign an issue to Copilot'),\n  ('n', 'Highest effort')]),\n ('proof', 'Proof in public repos', 0, [\n  ('y', '4 upstream PRs, all open (see the record above)'),\n  ('p', 'Not specific to docs'),\n  ('p', 'Not specific to docs'),\n  ('p', 'Not specific to docs'),\n  ('p', 'Depends on your build')]),\n]\nCOLS = [\n ('FirstRun', '<svg class=\"ci\" viewBox=\"0 0 64 64\" aria-hidden=\"true\"><use href=\"#lg\"/></svg>', 'me'),\n ('Claude Code', svg('<path d=\"M12 3v5M12 16v5M3 12h5M16 12h5M5.6 5.6l3.5 3.5M14.9 14.9l3.5 3.5M18.4 5.6l-3.5 3.5M9.1 14.9l-3.5 3.5\"/>', ' class=\"ci\"'), ''),\n ('GitHub Actions', svg('<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M10 8.5l5 3.5-5 3.5z\"/>', ' class=\"ci\"'), ''),\n ('GitHub Agents', svg('<rect x=\"4\" y=\"7\" width=\"16\" height=\"12\" rx=\"3\"/><path d=\"M12 7V4M9 12.5v1M15 12.5v1\"/><path d=\"M2.5 12.5v2M21.5 12.5v2\"/>', ' class=\"ci\"'), ''),\n ('Custom workflow', svg('<path d=\"M14.7 6.3a4 4 0 00-5 5L3.5 17.5a1.8 1.8 0 002.6 2.6l6.2-6.2a4 4 0 005-5l-2.4 2.4-2-.5-.5-2z\"/>', ' class=\"ci\"'), ''),\n]\nthead = '<tr><th scope=\"col\" class=\"f1\">Feature</th>' + ''.join('<th scope=\"col\"%s>%s<span>%s</span></th>' % (' class=\"me\"' if c[2] else '', c[1], c[0]) for c in COLS) + '</tr>'\ntrs = ''\nfor ic, feat, hl, cells in ROWS:\n    badge = '<em>Stands out</em>' if hl else ''\n    tds = ''\n    for i, (m, t) in enumerate(cells):\n        tds += '<td%s><span class=\"cell\">%s<span>%s</span></span></td>' % (' class=\"me\"' if i == 0 else '', M[m], t)\n    trs += '<tr%s><th scope=\"row\"><span class=\"rh\"><i>%s</i><span>%s%s</span></span></th>%s</tr>\\n' % (' class=\"hl\"' if hl else '', IC[ic], feat, badge, tds)\n\nlegend = '<div class=\"lgd\" aria-label=\"Legend\"><span>%s Yes</span><span>%s Partly or with setup</span><span>%s No</span></div>' % (YES, PART, NO)\n\na = h.index('<section id=\"compare\">')\nb = h.index('</section>', a) + len('</section>')\nnew = '''<section id=\"compare\">\n<h2>How FirstRun Compares.</h2>\n''' + legend + '''\n<div class=\"cmp rv\"><div class=\"cmp-s\"><table>\n<thead>''' + thead + '''</thead>\n<tbody>\n''' + trs + '''</tbody></table></div></div>\n<div class=\"vp\">\n<p>FirstRun reads a docs quickstart and runs every step in a clean container, the way a new developer would. It stops at the first failure and classifies it. It tries a fix up to 3 times, then proves the fix with a second clean run. It asks once before it opens a PR.</p>\n<p>FirstRun opened 4 upstream docs PRs, and all are open today. The dbt DuckDB quickstart had a broken <code>jafgen</code> command (#10149) and no stated Python version (#10150). The Entire CLI installer put <code>entire</code> on a path that a clean shell lacks (entireio/cli#2724). The AccuKnox <code>knoxctl</code> page named 0.9.0 as the latest release while its installer fetched 0.9.58, and its APT steps assume <code>curl</code>, <code>gnupg</code> and <code>sudo</code> (accuknox/help#671). MkDocs and Dagster passed with no docs change, so a run also shows when docs hold up.</p>\n<p>Every run is a neatlogs trace, so a bad run has a readable cause. A docs bug surfaces in a run instead of in a reader who leaves without filing an issue. The four PRs now wait for maintainer review.</p>\n</div>\n</section>'''\nh = h[:a] + new + h[b:]\